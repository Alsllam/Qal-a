{
  "ConnectionStrings": {
    "Players": ""
  },
  "Auth": {
    "Authority": "http://localhost:5000/",
    "Audience": "players-api"
  },
  "MessageBroker": {
    "Transport": "RabbitMq",
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "RateLimiter": {
    "Window": 60,
    "PermitLimit": 120,
    "SegmentsPerWindow": 6
  },
  "Swagger": {
    "Title": "Qal'a Players API",
    "Version": "v1"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "MassTransit": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}