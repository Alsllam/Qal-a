<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Applies every module's migrations and runs the idempotent seeders (permissions, OpenIddict clients and scopes).</Description>
    <UserSecretsId>qala-game-dbmigrator</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Qala.Framework.EntityFrameworkCore\Qala.Framework.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\Modules\Matches\Qala.Game.Matches.EntityFrameworkCore\Qala.Game.Matches.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\Modules\Players\Qala.Game.Players.EntityFrameworkCore\Qala.Game.Players.EntityFrameworkCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
