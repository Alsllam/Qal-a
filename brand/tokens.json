{
  "$schema": "Qal'a brand tokens. Single source of truth: edit here, then run `python3 brand/tools/build_tokens.py`.",
  "name": { "en": "Qal'a", "ar": "قلعة" },
  "color": {
    "brand": {
      "50": "#EEF0FA", "100": "#D9DCF1", "200": "#B3B9E3", "300": "#8790D2", "400": "#5F6CC0",
      "500": "#3D4BA6", "600": "#313D8C", "700": "#273171", "800": "#1E2658", "900": "#151B40"
    },
    "accent": { "50": "#FDF5E1", "400": "#ECB53F", "500": "#E0A21B", "600": "#B9820C", "700": "#8C620A" },
    "water": { "50": "#E3F2FB", "300": "#7CC3EC", "500": "#2F8FD0", "700": "#1D6698" },
    "neutral": {
      "0": "#FFFFFF", "50": "#FBF7EF", "100": "#F6EBD6", "200": "#EBD8B6", "300": "#DDC193", "400": "#BFA071",
      "500": "#9A7D52", "600": "#7A6140", "700": "#5C4930", "800": "#3D3122", "900": "#231C14"
    },
    "status": {
      "success": { "50": "#E3F5EC", "500": "#2E9D6B", "700": "#1F6E4B" },
      "warning": { "50": "#FDF5E1", "500": "#E0A21B", "700": "#8C620A" },
      "danger":  { "50": "#FBE7E6", "500": "#D64541", "700": "#9E2C29" },
      "info":    { "50": "#E3F2FB", "500": "#2F8FD0", "700": "#1D6698" }
    },
    "game": {
      "boardLight": "#EFD9B0", "boardDark": "#E2C291", "boardEdge": "#8A6235",
      "southFill": "#FFF6E0", "southEdge": "#7A4E1D", "northFill": "#2F3B8F", "northEdge": "#111A4F",
      "qalaSouth": "#C9A46A", "qalaNorth": "#8C93C2",
      "well": "#2F8FD0", "supplyGlow": "#4FC3F7", "selection": "#E0A21B", "capture": "#D64541"
    }
  },
  "themes": {
    "light": {
      "primary": "brand.500", "onPrimary": "neutral.0", "accent": "accent.500", "onAccent": "neutral.900",
      "surface": "neutral.0", "surfaceRaised": "neutral.50", "surfaceSunken": "neutral.100",
      "textPrimary": "neutral.900", "textSecondary": "neutral.700", "textMuted": "neutral.600",
      "borderSubtle": "neutral.200"
    },
    "dark": {
      "primary": "brand.300", "onPrimary": "brand.900", "accent": "accent.400", "onAccent": "neutral.900",
      "surface": "#161A33", "surfaceRaised": "#1E2344", "surfaceSunken": "#0F1226",
      "textPrimary": "brand.50", "textSecondary": "brand.200", "textMuted": "brand.300",
      "borderSubtle": "#2C3360"
    }
  },
  "contrastPairs": [
    ["light", "textPrimary", "surface", 4.5], ["light", "textSecondary", "surface", 4.5],
    ["light", "textMuted", "surfaceRaised", 4.5], ["light", "onPrimary", "primary", 4.5],
    ["light", "onAccent", "accent", 4.5], ["light", "primary", "surfaceSunken", 3.0],
    ["dark", "textPrimary", "surface", 4.5], ["dark", "textSecondary", "surface", 4.5],
    ["dark", "textMuted", "surfaceRaised", 4.5], ["dark", "onPrimary", "primary", 4.5],
    ["dark", "onAccent", "accent", 4.5]
  ],
  "typography": {
    "arabic": "IBM Plex Sans Arabic", "latin": "IBM Plex Sans", "mono": "IBM Plex Mono",
    "scale": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 20, "2xl": 24, "3xl": 30, "4xl": 36 },
    "weights": [400, 500, 600, 700], "lineHeight": { "body": 1.5, "heading": 1.25 }
  },
  "radius": { "sm": 6, "md": 8, "lg": 12, "xl": 16 },
  "spacing": [4, 8, 16, 24, 32, 48],
  "shadow": {
    "sm": "0 1px 2px rgba(21,27,64,.08), 0 1px 3px rgba(21,27,64,.06)",
    "md": "0 4px 8px rgba(21,27,64,.08), 0 2px 4px rgba(21,27,64,.06)",
    "lg": "0 12px 24px rgba(21,27,64,.12), 0 4px 8px rgba(21,27,64,.08)"
  },
  "motion": {
    "fast": 120, "base": 200, "slow": 320, "logo": 800,
    "easeOut": [0.2, 0.8, 0.2, 1], "easeIn": [0.4, 0, 1, 1]
  }
}
