{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "RateLimiter": {
    "Window": 60,
    "PermitLimit": 600,
    "SegmentsPerWindow": 6
  },
  "ReverseProxy": {
    "Routes": {
      "auth-connect": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/connect/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "auth-account": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/account/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "auth-well-known": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "players-api": {
        "ClusterId": "players",
        "Match": {
          "Path": "/players-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/players-api"
          }
        ]
      },
      "matches-api": {
        "ClusterId": "matches",
        "Match": {
          "Path": "/matches-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/matches-api"
          }
        ]
      },
      "matches-hub": {
        "ClusterId": "matches",
        "Match": {
          "Path": "/hubs/match/{**catch-all}"
        }
      },
      "ai-api": {
        "ClusterId": "ai",
        "Match": {
          "Path": "/ai-api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth-1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "players": {
        "Destinations": {
          "players-1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "matches": {
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "AffinityKeyName": ".Qala.Matches.Affinity"
        },
        "Destinations": {
          "matches-1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "ai": {
        "HttpRequest": {
          "ActivityTimeout": "00:05:00"
        },
        "Destinations": {
          "ai-1": {
            "Address": "http://localhost:8000/"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}