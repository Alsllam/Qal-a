{
  "ConnectionStrings": {
    "Matches": ""
  },
  "Auth": {
    "Authority": "http://localhost:5000/",
    "Audience": "matches-api"
  },
  "MessageBroker": {
    "Transport": "RabbitMq",
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiter": {
    "Window": 60,
    "PermitLimit": 300,
    "SegmentsPerWindow": 6
  },
  "Matches": {
    "Clock": {
      "SweepIntervalSeconds": 1
    }
  },
  "Swagger": {
    "Title": "Qal'a Matches API",
    "Version": "v1"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "MassTransit": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
