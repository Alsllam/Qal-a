# Copy to .env for local development. Never commit .env. Values are intentionally empty.
ENVIRONMENT=local
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=

# Azure OpenAI (v1 endpoint: {endpoint}/openai/v1/). Deployed environments use Entra ID (no key).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
DEPLOYMENTS__CHAT=
DEPLOYMENTS__FAST=
DEPLOYMENTS__REASONING=
DEPLOYMENTS__EMBED=
EMBED_DIMENSIONS=
REASONING_EFFORT=

# Azure AI Search (SEARCH_BACKEND=memory uses in-process BM25 over MEMORY_SEED_PATHS, local only)
SEARCH_BACKEND=
SEARCH_ENDPOINT=
SEARCH_API_KEY=
SEARCH_INDEX_NAME=
SEARCH_SEMANTIC_CONFIG=
RERANKER_THRESHOLD=
MEMORY_SEED_PATHS=

# Auth (OpenIddict on Qala.Game.Auth.Host)
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
TENANT_CLAIM=
ROLES_CLAIM=
PERMISSIONS_CLAIM=
INGEST_PERMISSION=
ADMIN_PERMISSION=

# Limits, budgets, retention
RATE_LIMIT_PER_MINUTE=
CONTEXT_BUDGET_TOKENS=
CHAT_MAX_OUTPUT_TOKENS=
COACH_MAX_OUTPUT_TOKENS=
RETENTION_DAYS=
TOKENIZER_MODE=

# Prompt versions
ANSWER_PROMPT_VERSION=
COACH_PROMPT_VERSION=
REWRITE_PROMPT_VERSION=

# Prompt Shields (Azure AI Content Safety), optional
PROMPT_SHIELDS_ENABLED=
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_API_KEY=

# Database (SQL Server in cloud via an async driver, SQLite locally)
DATABASE_URL=

# Cost per 1M tokens, JSON keyed by deployment name: {"<deployment>":{"input":0,"cached_input":0,"output":0}}
PRICES=
