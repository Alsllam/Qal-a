{
  "ConnectionStrings": {
    "Auth": ""
  },
  "AuthServer": {
    "Issuer": "http://localhost:5000/",
    "AccessTokenLifetimeMinutes": 30,
    "RefreshTokenLifetimeDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiter": {
    "Window": 60,
    "PermitLimit": 60,
    "SegmentsPerWindow": 6
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenIddict": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
